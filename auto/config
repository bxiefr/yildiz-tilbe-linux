#!/bin/sh
# live-build ana ayarları. "lb config" çalışınca burası okunur.
set -e

lb config noauto \
	--distribution trixie \
	--architectures amd64 \
	--archive-areas "main contrib non-free non-free-firmware" \
	--binary-images iso-hybrid \
	--debian-installer none \
	--bootappend-live "boot=live components quiet splash locales=tr_TR.UTF-8 keyboard-layouts=tr timezone=Europe/Istanbul" \
	--iso-application "Yildiz Tilbe Linux" \
	--iso-publisher "Yildiz Tilbe Linux Projesi" \
	--iso-volume "YILDIZ_TILBE" \
	--image-name "yildiz-tilbe-linux" \
	"${@}"
